FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/package.json
RUN npm ci

COPY apps/web ./apps/web
RUN npm run build --workspace apps/web

FROM nginx:1.27-alpine

COPY deploy/web-nginx.conf.template /etc/nginx/templates/default.conf.template
COPY deploy/web-start.sh /usr/local/bin/sift-web-start
COPY --from=build /app/apps/web/dist /usr/share/nginx/html

RUN chmod 0555 /usr/local/bin/sift-web-start

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/sift-web-start"]
